NODE_ENV=development
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
POSTGRES_PORT=5432
REDIS_PORT=6379
DATABASE_URL=postgresql://stream:stream_dev_only@127.0.0.1:5432/stream_platform?schema=public
REDIS_URL=redis://127.0.0.1:6379
JWT_SECRET=local-development-jwt-secret-change-before-production
TOKEN_PEPPER=local-development-token-pepper-change-before-production
SOURCE_ENCRYPTION_KEY=local-development-source-key-change-before-production
IMPORT_EXECUTION_MODE=all
FREE_ACCESS_ENABLED=true

# Public TMDB metadata key (browser-visible; never use your API/source secrets here).
NEXT_PUBLIC_TMDB_API_KEY=
