# Copy to .env.production; never commit populated secrets.
PUBLIC_DOMAIN=watch.your-domain.com
RELEASE_TAG=2026-09-13
# Use independent cryptographically random values. Use URL-safe characters for the DB password.
POSTGRES_PASSWORD=
JWT_SECRET=
TOKEN_PEPPER=
# Preserve the encryption key used by any source vault data you are migrating.
SOURCE_ENCRYPTION_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
# Current launch mode is free viewing. Set false only when a real payment provider is added.
FREE_ACCESS_ENABLED=true
# Public metadata credential, embedded into the browser build.
NEXT_PUBLIC_TMDB_API_KEY=
